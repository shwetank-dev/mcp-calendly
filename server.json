{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.nimblebrain/calendly",
  "title": "Calendly",
  "description": "MCP server for Calendly scheduling",
  "version": "0.1.0",
  "websiteUrl": "https://nimblebrain.ai",
  "repository": {
    "url": "https://github.com/NimbleBrainInc/mcp-calendly",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@nimblebraininc/mcp-calendly",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CALENDLY_API_KEY",
          "description": "Personal Access Token from https://calendly.com/integrations/api_webhooks",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tool": "mcpb",
      "version": "0.4"
    },
    "org.mpaktrust": {
      "mtf_version": "0.1",
      "permissions": {
        "network": ["api.calendly.com"],
        "filesystem": "none",
        "subprocess": "none"
      }
    }
  }
}
